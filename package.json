{
  "name": "my-website-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "lint": "pnpm --filter frontend lint",
    "lint:frontend": "pnpm --filter frontend lint",
    "start:frontend": "pnpm --filter frontend start",
    "start:backend": "pnpm --filter backend start",
    "pm2:build": "pnpm --filter @my-website/schemas build && pnpm --filter @my-website/api build && pnpm --filter backend build && pnpm --filter frontend build",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:backend": "pm2 start ecosystem.config.cjs --only backend",
    "pm2:start:frontend": "pm2 start ecosystem.config.cjs --only frontend",
    "pm2:restart": "pm2 restart all",
    "pm2:stop": "pm2 stop all",
    "pm2:delete": "pm2 delete all",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs"
  },
  "devDependencies": {
    "serve": "^14.2.6"
  }
}
